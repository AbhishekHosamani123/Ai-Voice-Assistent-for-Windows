# ---- Copy to backend/.env and fill in real values. Never commit .env. ----

# Groq (LLM + Whisper STT): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=en

# ElevenLabs (TTS): https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Find voice IDs at https://elevenlabs.io/app/voices (leave empty for plugin default)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# TTS engine: elevenlabs (default) | groq (OpenAI-compatible speech API, no extra key)
# groq fallback needs terms accepted once: https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
TTS_PROVIDER=elevenlabs
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=tara

# LiveKit (Cloud project keys, or your self-hosted server): https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Agent name used for explicit room dispatch (matches the token server)
AGENT_NAME=runamarga-voice-agent


# LLM behavior
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=256

# Token server
TOKEN_SERVER_PORT=8000
CORS_ORIGINS=http://localhost:3000
